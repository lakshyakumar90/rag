# Copy to `.env` (or `.env.local`) and fill in values.
# Never commit real secrets.

# Docker Compose (local infra)
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=rag
OLLAMA_PORT=11434

# Ollama (embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:440m
# Verified at runtime: served vectors are 768-dimensional
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_MAX_RETRIES=3
# EMBEDDING_RETRY_BACKOFF_SECONDS=1.0
# EMBEDDING_NORMALIZE=true

# Chat / LLM provider (interface + registry; Ollama is the built-in provider)
# LLM_PROVIDER=ollama
# OLLAMA_LLM_MODEL=llama3.2:latest
# LLM_TIMEOUT_SECONDS=120

# OpenAI-compatible endpoints (set base_url/model for Gemini compat,
# OpenRouter, Groq, Ollama's /v1, or OpenAI itself)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# Anthropic Messages API
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=

# BYOK key encryption. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LLM_MASTER_KEY=
# Allow localhost/private base_urls (local development only)
# LOCAL_MODE_ENABLED=false

# RAG / app (add as needed)
API_PORT=8000
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# API_KEY=

# Auth / JWT (override the secret outside local development)
JWT_SECRET_KEY=dev-only-jwt-secret-change-me-in-non-production
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# Login rate limiting (Redis counters: per client IP and per email)
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Set true only when the app sits behind a trusted reverse proxy.
# TRUST_PROXY_HEADERS=false

# Refresh-token cookie (HttpOnly is always on; Secure defaults on)
# REFRESH_COOKIE_NAME=refresh_token
# REFRESH_COOKIE_PATH=/api/v1/auth
# REFRESH_COOKIE_SAMESITE=lax
# Disable Secure only for local plain-HTTP development:
# REFRESH_COOKIE_SECURE=false

# Document uploads
# MAX_UPLOAD_SIZE_BYTES=26214400
# PRESIGNED_URL_TTL_SECONDS=900

# Background ingestion worker (ARQ; shares the Redis instance)
# INGEST_MAX_TRIES=3
# INGEST_RETRY_BACKOFF_SECONDS=2.0
# INGEST_JOB_TIMEOUT_SECONDS=300
# WORKER_MAX_JOBS=10

# Chunking: ~500 tokens with 50-token overlap; auto uses heading paths when available
# CHUNK_TARGET_TOKENS=500
# CHUNK_OVERLAP_TOKENS=50
# CHUNKING_STRATEGY=auto  # auto | fixed | paragraph | heading
# CHUNK_INSERT_BATCH_SIZE=100

# Invitations (token/link is returned in the API response; no mail server)
# INVITATION_TTL_DAYS=7
# INVITATION_ACCEPT_BASE_URL=http://localhost:3000/invitations/accept

# Frontend (access token kept in memory, refresh token in the HttpOnly cookie)
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# CLI mode (proposed: local only, off by default)
# CLI_MODE_ENABLED=false
