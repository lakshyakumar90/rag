# VCS / local metadata
.git
.gitignore
**/__pycache__
*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache

# Local environments and secrets (never bake .env into an image)
.venv
.env
.env.*
!.env.example

# Installed JS dependencies and build output are regenerated in the image.
# Source for apps/web and packages/ is kept so the web image can build.
node_modules
**/node_modules
**/.next
**/dist
*.tsbuildinfo

# Misc
*.log
